# Copy to .env.production and replace every placeholder before deployment.
SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=simseklog
POSTGRES_USER=simseklog
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://simseklog:replace-with-a-strong-database-password@db:5432/simseklog
PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=https://www.example.com
CORS_ORIGINS=https://www.example.com,https://example.com
ENABLE_SCHEDULED_JOBS=true
ENABLE_ARVENTO_PORTAL_SCRAPER=false
MASTER_TENANT_CODE=master
MASTER_ADMIN_EMAIL=admin@example.com
MASTER_ADMIN_PASSWORD=replace-with-a-strong-admin-password
